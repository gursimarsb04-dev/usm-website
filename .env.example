# ── Supabase (create free project at supabase.com → Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ── Sanity (create free project at sanity.io/manage) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# ── Stripe (event ticketing) — dashboard.stripe.com/apikeys ──
# Leave STRIPE_SECRET_KEY unset and a paid event shows "registration not
# available yet" instead of silently registering people for free.
STRIPE_SECRET_KEY=            # sk_test_... or sk_live_...
NEXT_PUBLIC_BASE_URL=         # optional; used for Stripe redirect URLs if origin is unavailable

# Stripe webhook — Dashboard → Developers → Webhooks → Add endpoint
#   URL: https://unitedsikhmovement.org/api/stripe/webhook
#   Event: checkout.session.completed
# Without this, paid registrations stay stuck at payment_status='pending'
# forever — Stripe gets paid, but nothing tells the registrations table.
STRIPE_WEBHOOK_SECRET=        # whsec_...

# ── Board pages password gate ──
BOARD_PASSWORD=change-me

# ── Mailchimp (phase 2 — news sync) ──
MAILCHIMP_API_KEY=

# ── SEO / analytics (all public, all optional) ──
# Canonical origin for sitemap, canonical URLs, and share previews.
NEXT_PUBLIC_SITE_URL=https://unitedsikhmovement.org
# GA4 measurement ID (G-XXXXXXX). Enables analytics + the `sign_up` event.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads (Ad Grants) account tag (AW-XXXXXXXXX) and the conversion label for
# newsletter signups. Both needed for Ads to count a signup as a conversion.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
